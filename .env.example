# Copy to .env and adjust. Never commit the real file.

SECURESCAN_ENVIRONMENT=development
SECURESCAN_DEBUG=true

SECURESCAN_DATABASE_URL=postgresql+psycopg://securescan:securescan@localhost:5432/securescan

# Empty = in-process worker (dev). Set to switch to RQ with no code change.
SECURESCAN_REDIS_URL=

# REQUIRED outside development -- the app refuses to start on the default.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECURESCAN_JWT_SECRET=dev-only-insecure-secret-change-me

SECURESCAN_MODEL_DIR=artifacts/unixcoder-v1
SECURESCAN_MODEL_VERSION=unixcoder-v1
SECURESCAN_MIN_CONFIDENCE=0.5

# Comma-separated. Must not contain localhost outside development.
SECURESCAN_CORS_ORIGINS=http://localhost:3000

SECURESCAN_STORAGE_BACKEND=local
SECURESCAN_LOCAL_STORAGE_DIR=./.storage
# SECURESCAN_STORAGE_BACKEND=s3
# SECURESCAN_S3_BUCKET=securescan-artifacts
# SECURESCAN_AWS_REGION=us-east-1
